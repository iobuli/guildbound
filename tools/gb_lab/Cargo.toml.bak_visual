[package]
name = "gb_lab"
version = "0.1.0"
edition = "2024"
publish = false

[dependencies]
bevy = { version = "=0.19.1", default-features = false, features = ["std", "multi_threaded"] }
avian3d = { version = "=0.7.0", default-features = false, features = ["3d", "f32", "parry-f32", "xpbd_joints", "parallel"] }

[profile.dev]
opt-level = 1
[profile.dev.package."*"]
opt-level = 3
