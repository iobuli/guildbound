-/// Foot contact with hysteresis: lands below `down` m, lifts only above `up` m, and must hold a
-/// state for `min_ticks` before it can flip again. Stops the 3 cm threshold flickering.
-#[derive(Clone, Copy, Debug)]
-pub struct Contact { pub planted: bool, pub held: u32 }
-pub const DOWN_M: f32 = 0.03;
-pub const UP_M: f32 = 0.05;
-pub const MIN_TICKS: u32 = 6; // 50 ms at 120 Hz
-
-impl Contact {
-    pub fn new() -> Self { Contact { planted: false, held: MIN_TICKS } }
-    pub fn step(&mut self, sole_height: f32) -> bool {
-        self.held = self.held.saturating_add(1);
-        let want = if self.planted { sole_height < UP_M } else { sole_height < DOWN_M };
-        if want != self.planted && self.held >= MIN_TICKS { self.planted = want; self.held = 0; }
-        self.planted
-    }
-}
