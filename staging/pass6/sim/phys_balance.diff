+/// τ = ((kb·e + kbd·ė) × up)·M·g, e = COM − support centre (x, z). kb is 1/m, kbd s/m. Ramped by `ramp`.
+pub fn balance_kb(mass: f32, com: V3, com_vel: V3, centre: [f32; 2], kb: f32, kbd: f32, ticks_since_on: u64) -> V3 {
